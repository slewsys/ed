#| "Options:\n"
#| "  -E, --regexp-extended     Enable extended regular expression syntax.\n"
#| "  -e, --expression=COMMAND  Add COMMAND to scripted input - implies `-"
#| "s'.\n"
#| "  -f, --file=SCRIPT         Read commands from file SCRIPT - implies `-"
#| "s'.\n"
#| "  -G, --traditional         Enable backward compatibility.\n"
